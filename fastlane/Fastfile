default_platform(:ios)

platform :ios do
  desc "Build the app and upload it to TestFlight"
  lane :beta do
    require "shellwords"
    require "yaml"

    required_env = %w[
      APP_STORE_CONNECT_KEY_ID
      APP_STORE_CONNECT_ISSUER_ID
      APP_STORE_CONNECT_API_KEY_PATH
    ]
    missing = required_env.select { |key| ENV[key].to_s.strip.empty? }
    UI.user_error!("Missing required environment variable(s): #{missing.join(', ')}") unless missing.empty?

    project_config = YAML.safe_load_file("project.yml")
    team_id = project_config.dig("settings", "base", "DEVELOPMENT_TEAM").to_s.strip
    UI.user_error!("Missing DEVELOPMENT_TEAM in project.yml settings.base") if team_id.empty?

    api_key_path = ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH")
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID").strip,
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID").strip,
      key_filepath: api_key_path,
      in_house: false
    )

    increment_build_number(
      xcodeproj: "Padel.xcodeproj",
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    )

    # Xcode authenticates to Apple with the App Store Connect API key and uses
    # automatic/cloud-managed signing. No exported .p12 or manually managed
    # provisioning profile is stored in GitHub.
    signing_args = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{api_key_path.shellescape}",
      "-authenticationKeyID #{ENV.fetch('APP_STORE_CONNECT_KEY_ID').strip.shellescape}",
      "-authenticationKeyIssuerID #{ENV.fetch('APP_STORE_CONNECT_ISSUER_ID').strip.shellescape}",
      "DEVELOPMENT_TEAM=#{team_id.shellescape}"
    ].join(" ")

    build_app(
      scheme: "PadelApp",
      project: "Padel.xcodeproj",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      xcargs: signing_args,
      export_xcargs: signing_args,
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: team_id
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
