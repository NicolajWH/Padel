default_platform(:ios)

platform :ios do
  desc "Build the app and upload it to TestFlight"
  lane :beta do
    require "shellwords"

    required_env = %w[
      APP_STORE_CONNECT_KEY_ID
      APP_STORE_CONNECT_ISSUER_ID
      APP_STORE_CONNECT_API_KEY_PATH
      APPLE_TEAM_ID
      APP_DISPLAY_NAME
      APP_BUNDLE_IDENTIFIER
      WATCH_APP_BUNDLE_IDENTIFIER
      WIDGET_BUNDLE_IDENTIFIER
      WATCH_WIDGET_BUNDLE_IDENTIFIER
      ICLOUD_CONTAINER_IDENTIFIER
    ]
    missing = required_env.select { |key| ENV[key].to_s.strip.empty? }
    UI.user_error!("Missing required environment variable(s): #{missing.join(', ')}") unless missing.empty?

    team_id = ENV.fetch("APPLE_TEAM_ID").strip
    api_key_path = ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH")
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID").strip,
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID").strip,
      key_filepath: api_key_path,
      in_house: false
    )

    increment_build_number(
      xcodeproj: "Padel.xcodeproj",
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    )

    # GitHub Variables are the single source of truth for app identity in CI.
    # Xcode authenticates with the App Store Connect API key and uses automatic
    # cloud-managed signing; no exported .p12 or manual provisioning is stored.
    signing_args = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{api_key_path.shellescape}",
      "-authenticationKeyID #{ENV.fetch('APP_STORE_CONNECT_KEY_ID').strip.shellescape}",
      "-authenticationKeyIssuerID #{ENV.fetch('APP_STORE_CONNECT_ISSUER_ID').strip.shellescape}",
      "DEVELOPMENT_TEAM=#{team_id.shellescape}",
      "APP_DISPLAY_NAME=#{ENV.fetch('APP_DISPLAY_NAME').strip.shellescape}",
      "APP_BUNDLE_IDENTIFIER=#{ENV.fetch('APP_BUNDLE_IDENTIFIER').strip.shellescape}",
      "WATCH_APP_BUNDLE_IDENTIFIER=#{ENV.fetch('WATCH_APP_BUNDLE_IDENTIFIER').strip.shellescape}",
      "WIDGET_BUNDLE_IDENTIFIER=#{ENV.fetch('WIDGET_BUNDLE_IDENTIFIER').strip.shellescape}",
      "WATCH_WIDGET_BUNDLE_IDENTIFIER=#{ENV.fetch('WATCH_WIDGET_BUNDLE_IDENTIFIER').strip.shellescape}",
      "ICLOUD_CONTAINER_IDENTIFIER=#{ENV.fetch('ICLOUD_CONTAINER_IDENTIFIER').strip.shellescape}"
    ].join(" ")

    build_app(
      scheme: "PadelApp",
      project: "Padel.xcodeproj",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      xcargs: signing_args,
      export_xcargs: signing_args,
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: team_id
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
